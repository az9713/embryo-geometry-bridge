  "independent_program": "from pathlib import Path\nfrom fractions import Fraction as Q\nfrom itertools import product\nimport sys,json,hashlib\nsys.path.insert(0,str(Path('controlled_furrowing/scripts').resolve()))\nfrom nodal_observer_error_transfer import curve_bound,endpoint_bounds\nroot=Path('controlled_furrowing');sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\neps=Q(1,1000);checks={};examples=[]\ndef N(t):return [1-3*t+2*t*t,4*t-4*t*t,-t+2*t*t]\ndef dN(t):return [-3+4*t,4-8*t,-1+4*t]\ndef poly(nodes,t):return sum(a*b for a,b in zip(nodes,N(t)))\ndef deriv(nodes,t):return sum(a*b for a,b in zip(nodes,dN(t)))\ndef inverse_bracket(nodes,r):\n lo,hi=Q(0),Q(1)\n for _ in range(48):\n  mid=(lo+hi)/2\n  if poly(nodes,mid)==r:return mid,mid\n  if poly(nodes,mid)<r:lo=mid\n  else:hi=mid\n return lo,hi\nchecks['basis_partition_unity']=all(sum(N(Q(k,128)))==1 for k in range(129))\nchecks['value_Lebesgue_max5over4_on_critical_grid']=max(sum(map(abs,N(Q(k,128)))) for k in range(129))==Q(5,4)\nchecks['derivative_l1_max8_at_breakpoints']=max(sum(map(abs,dN(t))) for t in (Q(0),Q(1,4),Q(1,2),Q(3,4),Q(1)))==8\nchecks['sharp_value_attained_at_quarter']=sum(a*b for a,b in zip(N(Q(1,4)),(eps,eps,-eps)))==Q(5,4)*eps\nchecks['sharp_radial_derivative_attained_at_endpoint']=sum(a*b for a,b in zip(dN(0),(-eps,eps,-eps)))==8*eps\nbaseR=[Q(0),Q(1,2),Q(1)];baseZ=[Q(0),Q(2),Q(5)] # Z=3t+2t^2, globalLip7\nbase=[list(zip(baseR,baseZ))];bound=curve_bound(base,eps,roi_um=(Q(1,10),Q(9,10)));E=Q(bound['Eulerian_vertical_error_um_exact'])\nchecks['independent_slope7_and_bound10epsilon']=Q(bound['base_graph_Lipschitz_upper_exact'])==7 and E==10*eps\nfor i,(r_sign,z_sign) in enumerate(product(product((-1,1),repeat=3),repeat=2)):\n R=[a+s*eps for a,s in zip(baseR,r_sign)];Z=[a+s*eps for a,s in zip(baseZ,z_sign)]\n margin=min(deriv(R,0),deriv(R,1));allpoints=True;maximum=Q(0)\n for k in range(17):\n  r=Q(1,10)+Q(4,5)*Q(k,16);lo,hi=inverse_bracket(R,r)\n  # All Z' >= 3-8eps>0, so endpoint evaluation encloses Z at the inverse.\n  alo,ahi=poly(Z,lo),poly(Z,hi);basevalue=3*r+2*r*r;err=max(abs(alo-basevalue),abs(ahi-basevalue));maximum=max(maximum,err);allpoints &= err<=E\n checks['independent_control_corner_'+str(i)]=allpoints and margin>=1-8*eps\n examples.append({'radial_signs':r_sign,'vertical_signs':z_sign,'minimum_radial_derivative':str(margin),'maximum_17point_error_upper':str(maximum),'theorem_bound':str(E)})\n# A point crossing a shared knot: base inverse is on edge2 while perturbed\n# inverse is on edge1. A same-edge local Lip0 would be wrong.\nbase2=[[(0,0),(Q(1,2),0),(1,0)],[(1,0),(Q(3,2),2),(2,4)]]\ncross=curve_bound(base2,eps,fixed_radial_endpoints=True);radius=1+eps/2;actualerror=4*(radius-1)\nchecks['crossedge_comparison_requires_global_base_Lip']=actualerror==2*eps and actualerror>Q(5,4)*eps and actualerror<=Q(cross['Eulerian_vertical_error_um_exact'])\nflat=[[(0,0),(Q(1,2),0),(1,0)]];longer=[[(0,0),(1,0),(2,0)]]\nchecks['different_default_surface_domains_not_composed']=endpoint_bounds(flat,longer,eps,fixed_radial_endpoints=True)['status']=='UNRESOLVED_COMMON_SURFACE_ROI'\nchecks['explicit_common_ROI_composes_different_full_domains']=endpoint_bounds(flat,longer,eps,fixed_radial_endpoints=True,roi_um=(Q(1,10),Q(9,10)))['status']=='CONDITIONAL_EXACT_ERROR_TRANSFER'\ntry:endpoint_bounds(flat,flat,0,fixed_radial_endpoints=True,roi_um=(Q(1,2),Q(1,2)));checks['zero_mass_ROI_rejected_for_means']=False\nexcept ValueError:checks['zero_mass_ROI_rejected_for_means']=True\nchecks['pointwise_curve_zero_width_still_defined']=curve_bound(flat,0,fixed_radial_endpoints=True,roi_um=(Q(1,2),Q(1,2)))['status']=='CONDITIONAL_EXACT_ERROR_TRANSFER'\nchecks['unverified_endpoints_do_not_guarantee_full_ROI']=curve_bound(flat,eps)['status']=='UNRESOLVED_COMMON_RADIAL_DOMAIN'\nchecks['strict_monotonicity_margin_required']=curve_bound(flat,Q(1,8),fixed_radial_endpoints=True)['status']=='UNRESOLVED_RADIAL_MONOTONICITY'\ncombo=endpoint_bounds(base,flat,eps,fixed_radial_endpoints=True)\nchecks['same_ROI_endpoint_triangle_bounds']=Q(combo['endpoint_error_um_exact']['maximum_shortening_um'])==Q(combo['apical']['Eulerian_vertical_error_um_exact'])+Q(combo['basal']['Eulerian_vertical_error_um_exact']) and combo['apical']['ROI_um_exact']==combo['basal']['ROI_um_exact']\n# Unchanged references/weights are assumptions: same surface with eps0 cannot\n# bound a hypothetical independently shifted reference (not a module bug).\nchecks['reference_change_not_silently_included']=curve_bound(flat,0,fixed_radial_endpoints=True)['Eulerian_vertical_error_um_exact']=='0'\nroot_tests=json.loads((root/'evidence/nodal_observer_error_transfer_tests.json').read_text())\nchecks['current13root_synthetics_hashbound']=len(root_tests['checks'])==13 and all(root_tests['checks'].values()) and root_tests['script_sha256']==sha(root/'scripts/nodal_observer_error_transfer.py')\nreceipt={'status':'PASS_CONDITIONAL_EXACT_NODAL_TO_OBSERVER_TRANSFER' if all(checks.values()) else 'FAIL','checks':checks,'independent_control_examples':examples,'crossedge_exact_example':{'base_controls':[[list(map(str,p)) for p in edge] for edge in base2],'epsilon':str(eps),'compared_radius':str(radius),'actual_Eulerian_error':str(actualerror),'global_theorem_bound':cross['Eulerian_vertical_error_um_exact'],'explanation':'Perturbed shared radius is1+epsilon, with affine radial edges and unchangedZ; r=1+epsilon/2 lies in perturbededge1 and baseedge2.'},'reviewed_hashes':{p.relative_to(root).as_posix():sha(p) for p in (root/'scripts/nodal_observer_error_transfer.py',root/'docs/NODAL-OBSERVER-ERROR-TRANSFER.md',root/'evidence/nodal_observer_error_transfer_tests.json',root/'scripts/annulus_observer.py')},'independent_program':REVIEW_CODE,'method':'Own exact basis and inverse bisection;64independent radial/vertical nodal sign corners at17currentradiuspoints each; independent cross-edge and domain/mass guard checks. Formal allpoint bound reviewed separately in prose; finite testgrid is corroboration, not proof.','initial_findings_and_resolutions':['Parentretainedinitialsame-ROIcompositiongap revision; currentAPIrefuses differing defaultsurfaceROIs.','Reviewerfoundzero-widthROIacceptedforregionalmeans; parentretainedrevision and addedpositive-massguard. Pointwisecurvebound stillpermits singletonROI.'],'scope':'Requires independently verified nodal coordinate bound, corresponding conformingnodes, strict radialmargin, common covered fixedROI, fixedreferences and fixednormalizednonnegativeweights. No actualepsilon/root/PDE/temporal/experimental error certificate inferred.'}\n(root/'evidence/nodal_observer_error_independent_review.json').write_text(json.dumps(receipt,indent=2),encoding='utf-8')\nprint(json.dumps({'status':receipt['status'],'checks':len(checks),'failed':[k for k,v in checks.items() if not v],'corners':len(examples)},indent=2))\nif not all(checks.values()):raise RuntimeError('Retained nodal-transfer review failure')\n",
  "method": "Own exact basis and inverse bisection;64independent radial/vertical nodal sign corners at17currentradiuspoints each; independent cross-edge and domain/mass guard checks. Formal allpoint bound reviewed separately in prose; finite testgrid is corroboration, not proof.",
