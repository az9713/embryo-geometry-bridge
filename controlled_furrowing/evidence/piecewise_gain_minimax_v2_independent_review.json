  "independent_replay_python": "from pathlib import Path\nfrom fractions import Fraction as F\nimport csv,json,hashlib\np=Path('controlled_furrowing');d=p/'runs/joint_gain_extension_v2'\nq=json.loads((d/'protocol.json').read_text());t=json.loads((d/'response_table.json').read_text());c=json.loads((d/'surrogate_candidates.json').read_text())\nsha=lambda z:hashlib.sha256(z.read_bytes()).hexdigest()\nassert c['protocol_sha256']==t['protocol_sha256']==sha(d/'protocol.json') and c['response_table_sha256']==sha(d/'response_table.json')\nassert all(sha(p/'scripts'/n)==h for n,h in q['source_hashes'].items())\nrows=list(csv.DictReader((p/'data/derived/calibration_small_18um.csv').open()))\nassert len(rows)==17 and sha(p/'data/derived/calibration_small_18um.csv')==q['calibration_csv_sha256']\nkeys=('maximum_shortening_um','region_averaged_shortening_um','apical_max_shortening_um','basal_max_shortening_um')\nI=[F(z['activation_magnitude'])for z in rows];Y=[[F(z[k])for k in keys]for z in rows];nodes=[F(z['strength_exact'])for z in t['rows']]\nlo,hi=F(0),max(nodes)/max(I);assert lo==0 and hi==20/max(I)\ncuts=sorted({lo,hi}|{x/y for x in nodes for y in I if lo<x/y<hi});assert len(cuts)==43\nfor variant in c['variants']:\n name=variant['variant'];fit=variant['surrogate_fit'];V=[]\n for row in t['rows']:\n  vals=[]\n  for key in keys:\n   a,b=map(F,row['variant_endpoint_intervals'][name][key]);assert a<=b;vals.append((a+b)/2)\n  V.append(vals)\n values=[]\n for cell,left,right in zip(fit['certified_cells'],cuts,cuts[1:]):\n  middle=(left+right)/2;lines=[]\n  for dose,yy in zip(I,Y):\n   j=next(i for i in range(len(nodes)-1)if nodes[i]<dose*middle<nodes[i+1])\n   for k,y in enumerate(yy):\n    slope=(V[j+1][k]-V[j][k])/(nodes[j+1]-nodes[j]);a=slope*dose;b=V[j][k]-slope*nodes[j]-y\n    lines.extend([(a,b),(-a,-b)])\n  lines.append((F(0),F(0)));assert lines==[(F(a),F(b))for a,b in cell['all_line_coefficients_exact']]\n  assert list(map(F,cell['cell_exact']))==[left,right]\n  x,L=F(cell['gain_exact']),F(cell['loss_exact']);assert left<=x<=right and max(a*x+b for a,b in lines)==L\n  inds=[i for i,(a,b)in enumerate(lines)if a*x+b==L];slopes=[lines[i][0]for i in inds]\n  assert inds==cell['active_line_indices'] and slopes==list(map(F,cell['active_slopes_exact']))\n  assert(x==left and max(slopes)>=0)or(x==right and min(slopes)<=0)or(left<x<right and min(slopes)<=0<=max(slopes))\n  values.append((L,x))\n assert len(values)==42 and min(values)==(F(fit['loss_exact']),F(fit['gain_exact'])) and lo<F(fit['gain_exact'])<hi\nprint('PASS:168 source-reconstructed convex certificates cover the entire v2gain interval; no optimizer called')\n",
